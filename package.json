{
  "name": "pelicandocs",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:site": "bun router/dev-server.mjs",
    "build": "next build",
    "prebuild": "bun scripts/check-content.mjs && bun scripts/sync-eggs.mjs --if-online",
    "postbuild": "bun scripts/check-paths.mjs && bun scripts/check-links.mjs",
    "test": "bun test",
    "typecheck": "fumadocs-mdx && next typegen && tsc --noEmit",
    "check:content": "bun scripts/check-content.mjs",
    "check:paths": "bun scripts/check-paths.mjs",
    "check:links": "bun scripts/check-links.mjs",
    "sync:eggs": "bun scripts/sync-eggs.mjs",
    "pack:docs": "bun scripts/pack-docs.mjs",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "@shikijs/transformers": "4.6.0",
    "fumadocs-core": "16.17.10",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "16.17.10",
    "lucide-react": "1.66.0",
    "mermaid": "12.2.0",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shiki": "4.6.0",
    "unist-util-visit": "5.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdast": "4.0.4",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-mdx": "3.0.0",
    "micromark-extension-mdxjs": "3.0.0",
    "postcss": "8.5.28",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "esbuild",
    "sharp"
  ]
}
